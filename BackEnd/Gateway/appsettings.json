{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "reader-route": {
        "ClusterId": "reader-cluster",
        "Match": {
          "Path": "/api/reader/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          }
        ]
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "reader-cluster": {
        "Destinations": {
          "reader-backend": {
            "Address": "http://reader-service:8082"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog-backend": {
            "Address": "http://catalog-service:8081"
          }
        }
      }
    }
  }
}